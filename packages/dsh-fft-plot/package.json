{
  "name": "@dsh-ft/dsh-fft-plot",
  "version": "0.1.0",
  "description": "FTShare data plotting for DeepSeek Harness: a bundled skill that renders query results into inline SVG charts with zero third-party dependencies.",
  "license": "MIT",
  "author": "Ben <ben@ft.tech>",
  "homepage": "https://github.com/gigaflw/dsh-fft-base/tree/dev/packages/dsh-fft-plot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigaflw/dsh-fft-base.git",
    "directory": "packages/dsh-fft-plot"
  },
  "bugs": {
    "url": "https://github.com/gigaflw/dsh-fft-base/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
